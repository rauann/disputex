# Generated by ./setup.sh. This file is safe to commit; .env is not.
SECRET_KEY_BASE=
VAULT_KEY=
MCP_TOKEN=

# Stripe test mode only. Boot refuses sk_live_ and rk_live_ unless ALLOW_LIVE=true.
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
ALLOW_LIVE=false

# Optional. Point stripity_stripe at a mock during local verification.
# STRIPE_API_BASE_URL=http://host.docker.internal:12111

# Bring your own key. The LLM client arrives in milestone 2; the values are loaded now.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AGENT_MODEL=openrouter:author/model
EMBEDDING_MODEL=openrouter:author/embedding-model

PHX_HOST=localhost
PORT=4000
POOL_SIZE=10
DEMO_SEED=true

# Compose sets this for the app service. Uncomment for `mix phx.server` on the host.
# DATABASE_URL=ecto://disputex:disputex@localhost/disputex_dev
